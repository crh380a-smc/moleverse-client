{
  "name": "mole-client",
  "version": "0.0.5",
  "description": "MoleVerse Electron Client",
  "keywords": [
    "Electron"
  ],
  "license": "MIT",
  "author": "C.R.H",
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -p always"
  },
  "devDependencies": {
    "electron": "^11.4.7",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-store": "^8.0.0",
    "electron-prompt": "^1.7.0"
  },
  "build": {
    "appId": "MoleVerseClient",
    "productName": "MoleVerseClient",
    "files": [
      "node_modules/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "extends": null,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/mole.icns",
      "artifactName": "${productName}-Darwin-${version}-${arch}.${ext}",
      "target": [
        "zip"
      ]
    },
    "win": {
      "verifyUpdateCodeSignature": false,
      "icon": "build/mole.ico",
      "artifactName": "${productName}-Windows-${version}.${ext}",
      "target": [
        "zip"
      ]
    },
    "linux": {
      "icon": "build/mole.png",
      "artifactName": "${productName}-Linux-${version}.${ext}",
      "target": [
        "zip"
      ]
    },
    "asar": false
  },
  "publish": [
    {
      "provider": "github",
      "owner": "crh380a-smc",
      "repo": "moleverse-client"
    }
  ]
}
