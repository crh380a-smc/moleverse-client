{
  "name": "mole-client",
  "version": "0.0.1",
  "description": "MoleVerse Electron Client",
  "keywords": [
    "MoleVerse",
    "Flash",
    "Electron"
  ],
  "license": "MIT",
  "author": "C.R.H",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -p always"
  },
  "devDependencies": {
    "electron": "^11.4.7",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-prompt": "^1.7.0"
  },
  "build": {
    "appId": "MoleVerseClient",
    "productName": "MoleVerseClient",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "config/**/*",
      "app/**/*",
      "config.js",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "extends": null,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/mole.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": ["zip"]
    },
    "win": {
      "verifyUpdateCodeSignature": false,
      "icon": "resources/mole.ico",
      "artifactName": "${productName}-${version}.${ext}",
      "target": ["zip"]
    },
    "linux": {
      "icon": "resources/mole.png",
      "artifactName": "${productName}-${version}.${ext}",
      "target": ["zip"]
    },
    "asar": false
  },
  "publish": [{
    "provider": "github",
    "owner": "crh380a-smc",
    "repo": "crh380a-smc/moleverse-client"
  }]
}
